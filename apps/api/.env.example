# ShopFlow API - development environment (copy to .env and fill in real values)
ENVIRONMENT=development
DEBUG=true

# Dedicated app role on the local PostgreSQL 17 instance.
DATABASE_URL=postgresql+psycopg://shopflow_app:CHANGE_ME@localhost:5432/shopflow_dev

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_value

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_EXPIRE_MINUTES=720
DEFAULT_LOCALE=en
